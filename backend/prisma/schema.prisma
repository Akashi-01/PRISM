// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model PromptSession {
  id              Int      @id @default(autoincrement())
  rawPrompt       String   @db.Text
  optimizedPrompt String?  @db.Text
  analysis        Json?
  meta            Json?
  tokensBefore    Int?
  tokensAfter     Int?
  tokensSaved     Int?
  percentSaved    Float?
  model           String?
  latencyMs       Int?
  createdAt       DateTime @default(now())
  clarifications  Json?
  currentRun      Int      @default(1)
  stages          StageResult[]
  evaluations         ResponseEvaluation[]
  evaluationSummaries EvaluationSummary[]
}

model StageResult {
  id           Int           @id @default(autoincrement())
  sessionId    Int
  stage        String
  output       Json
  inputTokens  Int           @default(0)
  outputTokens Int           @default(0)
  latencyMs    Int           @default(0)
  status       String
  error        String?       @db.Text
  provider     String?
  model        String?
  createdAt    DateTime      @default(now())
  runNumber    Int           @default(1)
  isCurrent    Boolean       @default(true)

  session      PromptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, stage, isCurrent])
}

model ResponseEvaluation {
  id                   Int      @id @default(autoincrement())
  sessionId            Int
  runNumber            Int
  variant              String   // "original" | "optimized"
  promptText           String   @db.Text
  responseText         String   @db.LongText
  genInputTokens       Int      @default(0)
  genOutputTokens      Int      @default(0)
  genLatencyMs         Int      @default(0)
  genProvider          String
  genModel             String
  judgeProvider        String
  judgeModel           String
  relevance            Int
  completeness         Int
  instructionFollowing Int
  formatCorrectness    Int
  overallScore         Float
  judgeRationale       String   @db.Text
  isCurrent            Boolean  @default(true)
  createdAt            DateTime @default(now())

  session PromptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, isCurrent])
}

model EvaluationSummary {
  id                  Int      @id @default(autoincrement())
  sessionId           Int
  runNumber           Int
  qualityOriginal     Float
  qualityOptimized    Float
  qualityDelta        Float
  qualityRetentionPct Float
  tokensSavedPct      Float
  hasClarifications   Boolean  @default(false)
  isCurrent           Boolean  @default(true)
  createdAt           DateTime @default(now())

  session PromptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, isCurrent])
}